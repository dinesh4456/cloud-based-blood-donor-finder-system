# ==============================================================================
# Environment Variables Template for Blood Donor Finder System
# Copy this file to .env and configure real credentials for production
# ==============================================================================

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=prod

# Database Configuration (Amazon RDS MySQL or local MySQL)
# Format: jdbc:mysql://<RDS_ENDPOINT>:3306/<DB_NAME>?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_URL=jdbc:mysql://bloodfinder-db.c123456789.us-east-1.rds.amazonaws.com:3306/blood_donor_finder_db?createDatabaseIfNotExist=true&useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=YourStrongRdsPasswordHere!

# Database Connection Pool Tuning
DB_POOL_MAX=20
DB_POOL_MIN_IDLE=10

# Security: JWT Configuration
# Generate a strong 256-bit or 512-bit secret using: openssl rand -hex 32
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Application Features
# Set to false in production to prevent seeding demo donors and requests
APP_SEED_DATA=false

# JVM Memory Management (Container/Server)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:InitialRAMPercentage=50.0
